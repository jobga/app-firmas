<?xml version="1.0" encoding="UTF-8"?>
<!-- Animalista · Plataforma de firmas — © Jonnathan Bucheli Galindo. Para Plesk en Windows (IIS).
     Las rutas son relativas a esta carpeta: sirve en la raíz, en un subdominio o en un subdirectorio. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files><clear /><add value="index.php" /></files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="Animalista: bloquear internos" stopProcessing="true">
          <match url="^(app|config)(/|$)" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Animalista: archivos existentes" stopProcessing="true">
          <match url=".*" />
          <conditions><add input="{REQUEST_FILENAME}" matchType="IsFile" /></conditions>
          <action type="None" />
        </rule>
        <rule name="Animalista: API" stopProcessing="true">
          <match url="^api(/.*)?$" />
          <action type="Rewrite" url="api/index.php" appendQueryString="true" />
        </rule>
        <rule name="Animalista: aplicación" stopProcessing="true">
          <match url=".*" />
          <conditions><add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" /></conditions>
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="app" />
          <add segment="config" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
