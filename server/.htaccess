# Animalista · Plataforma de firmas — © Jonnathan Bucheli Galindo
# Funciona en la raíz de un dominio, en un subdominio o en cualquier subdirectorio (p. ej. /firmas/ o /campanas/2026/).
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Detecta la carpeta de instalación y la guarda en BASE ("" en la raíz, "/firmas" en un subdirectorio).
  RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
  RewriteRule .* - [E=BASE:%1]

  # Carpetas internas nunca accesibles desde la web
  RewriteRule ^(app|config)(/|$) - [F,L]

  # Archivos existentes (assets, uploads, install, api/index.php)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # API
  RewriteRule ^api(/.*)?$ %{ENV:BASE}/api/index.php [QSA,L]

  # Carpetas existentes (install/)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Aplicación de una sola página
  RewriteRule ^ %{ENV:BASE}/index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
